LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5:3b
EVIDENCE_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
RUNTIME_CACHE_DIR=.private/runtime_cache
V2_CORPUS_PROFILE=expanded
# One total deadline shared by tags, embedding, chat, and evidence probes.
READINESS_MODEL_LOAD_TIMEOUT_SECONDS=60

# Local trusted-identity boundary. Generate all ignored identity artifacts with:
# python -m scripts.manage_demo_identity init
IDENTITY_JWKS_PATH=.private/identity/jwks.json
IDENTITY_FEEDBACK_HMAC_KEY_PATH=.private/identity/feedback_actor_hmac.key
IDENTITY_ISSUER=https://identity.localhost/
IDENTITY_AUDIENCE=enterprise-rag-api
IDENTITY_ALGORITHM=RS256
IDENTITY_TOKEN_TYPE=at+jwt
IDENTITY_OPERATOR_ROLE=rag.operator
IDENTITY_CLOCK_SKEW_SECONDS=30
IDENTITY_MAX_TOKEN_LIFETIME_SECONDS=900
IDENTITY_MAX_TOKEN_BYTES=8192
IDENTITY_JWKS_MAX_BYTES=65536
IDENTITY_JWKS_MAX_KEYS=8
IDENTITY_FEEDBACK_HMAC_KEY_MAX_BYTES=256

# Local load-profile credentials generated by the command above. Configure file
# sources OR raw token sources, never both. Streamlit reads the persona bundle
# and operator token from .private/identity directly.
RAG_BEARER_TOKEN_FILE=.private/identity/load_user_token.txt
RAG_OPERATOR_BEARER_TOKEN_FILE=.private/identity/operator_token.txt

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=8
# R5 promotes page fusion for server-classified finance known reports only.
RETRIEVAL_PROFILE=default
# Set false for immediate rollback. The policy list is server-owned and fail-closed.
RETRIEVAL_FINANCE_KNOWN_REPORT_PAGE_FUSION_ENABLED=true
RETRIEVAL_FINANCE_KNOWN_REPORT_POLICY_IDS=[]
# Legacy R4 canary compatibility. New deployments leave this empty.
RETRIEVAL_CANARY_POLICY_IDS=[]

SQLITE_PATH=data/app.db
