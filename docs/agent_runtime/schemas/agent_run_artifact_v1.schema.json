{
  "$defs": {
    "AgentEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "session.started",
            "user.message",
            "step.started",
            "model.requested",
            "model.responded",
            "tool.requested",
            "tool.completed",
            "tool.failed",
            "retrieval.completed",
            "evidence.admitted",
            "evidence.rejected",
            "claim.proposed",
            "claim.accepted",
            "claim.rejected",
            "citation.checked",
            "budget.updated",
            "human_review.requested",
            "human_review.completed",
            "terminal.reached",
            "session.completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "tool_name": {
          "anyOf": [
            {
              "enum": [
                "search",
                "find",
                "open"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "token_usage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "previous_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Hash"
        },
        "event_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Hash",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "trace_id",
        "sequence",
        "event_type",
        "timestamp",
        "event_hash"
      ],
      "title": "AgentEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "enterprise.agent-run",
      "default": "enterprise.agent-run",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Sha",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "trajectory": {
      "items": {
        "$ref": "#/$defs/AgentEvent"
      },
      "minItems": 1,
      "title": "Trajectory",
      "type": "array"
    },
    "retrieval": {
      "additionalProperties": true,
      "title": "Retrieval",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    },
    "terminal": {
      "additionalProperties": true,
      "title": "Terminal",
      "type": "object"
    },
    "source_trajectory_root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Trajectory Root Hash",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "git_sha",
    "created_at",
    "session_id",
    "trace_id",
    "input",
    "output",
    "trajectory",
    "retrieval",
    "evidence",
    "usage",
    "terminal",
    "source_trajectory_root_hash",
    "artifact_sha256"
  ],
  "title": "AgentRunArtifactV1",
  "type": "object"
}
