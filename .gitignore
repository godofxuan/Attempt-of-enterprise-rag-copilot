# Two frozen public packages preserve six manifest-bound synthetic metadata
# files at their source-relative paths. Do not generalize this exception.
!data/v2/public/lifecycle_g10_v2/dataset/.private/
!data/v2/public/lifecycle_g10_v2/dataset/.private/lifecycle/
!data/v2/public/lifecycle_g10_v2/dataset/.private/lifecycle/g10-expanded-lifecycle-v4/
!data/v2/public/lifecycle_g10_v2/dataset/.private/lifecycle/g10-expanded-lifecycle-v4/*.json
!data/v2/public/lifecycle_g10_v3/dataset/.private/
!data/v2/public/lifecycle_g10_v3/dataset/.private/lifecycle/
!data/v2/public/lifecycle_g10_v3/dataset/.private/lifecycle/g10-expanded-lifecycle-v4/
!data/v2/public/lifecycle_g10_v3/dataset/.private/lifecycle/g10-expanded-lifecycle-v4/*.json

